                  "type": "object",
                  "required": [
                    "apiVersion",
                    "kind",
                    "metadata"
                  ],
                  "properties": {
                    "apiVersion": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object",
                      "required": [
                        "name",
                        "uid",
                        "resourceVersion",
                        "namespace"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uid": {
                          "type": "string",
                          "minLength": 1
                        },
                        "resourceVersion": {
                          "type": "string",
                          "minLength": 1
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 0,
