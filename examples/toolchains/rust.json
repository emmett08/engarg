{
  "schema": "engarg.toolchain/2",
  "language": "rust",
  "docker": "docker",
  "image": "engarg-rust-tools:1.99.1",
  "build_argv": [
    "/usr/local/bin/build-collector",
    "--extern",
    "serde",
    "--extern",
    "serde_json",
    "--extern",
    "reqwest",
    "--extern",
    "why_rs",
    "--extern",
    "polars",
    "--extern",
    "statrs",
    "--extern",
    "nalgebra",
    "--extern",
    "varisat",
    "--extern",
    "linfa_nn",
    "--extern",
    "ndarray",
    "--extern",
    "good_lp",
    "/src/main.rs",
    "-o",
    "/build/collector"
  ],
  "run_argv": [
    "/build/collector"
  ],
  "inherit_env": [],
  "runtime_network": "none",
  "timeout_seconds": 60,
  "memory_mb": 1024,
  "output_bytes": 1048576,
  "generation": {
    "libraries": {
      "use_defaults": true,
      "fallback": "model",
      "tasks": {
        "optimisation": [
          {
            "package": "good_lp",
            "version": "1.14.2",
            "reference": "https://github.com/rust-or/good_lp",
            "guidance": "The prepared image provides good_lp with the pure Rust microlp backend as default_solver, without CBC. Preserve the authored objective, constraints, integrality and solver status; preparing a solver does not qualify a model."
          }
        ]
      }
    }
  }
}
