{
  "schema": "engarg.toolchain/2",
  "language": "typescript",
  "docker": "docker",
  "image": "engarg-typescript-tools:5.9.3",
  "build_argv": [
    "/opt/engarg-typescript/node_modules/.bin/tsc",
    "--strict",
    "--esModuleInterop",
    "--noEmitOnError",
    "--target",
    "ES2022",
    "--module",
    "commonjs",
    "--moduleResolution",
    "node",
    "--types",
    "node",
    "--typeRoots",
    "/opt/engarg-typescript/node_modules/@types",
    "--outDir",
    "/build",
    "/src/collector.ts"
  ],
  "run_argv": [
    "node",
    "/build/collector.js"
  ],
  "inherit_env": [],
  "runtime_network": "none",
  "timeout_seconds": 30,
  "memory_mb": 512,
  "output_bytes": 1048576,
  "generation": {
    "libraries": {
      "use_defaults": true,
      "fallback": "model",
      "tasks": {}
    }
  }
}
