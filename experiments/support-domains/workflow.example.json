{
  "schema": "engarg.support-workflow-study/2",
  "purpose": "exploratory",
  "sampling_justification": "One fully specified operation probes the generated route lifecycle. One repetition supplies a failure-mode observation, not a population estimate.",
  "cache_treatment": "New package and assessment stores per run. Specify the source-store initial state in the operator planning configuration. Provider caches uncontrolled.",
  "inference_unit": "case",
  "eal_revision": "REPLACE_WITH_EXACT_EAL_COMMIT",
  "max_model_calls": 22,
  "assets": {
    "toolchain": "/operator/rust-toolchain-profile.json",
    "qualifier": "/operator/independent-qualification",
    "qualification": "/operator/measurement-reference.json"
  },
  "cases": {
    "specified_algorithm": {
      "partition": "development",
      "genuine_code_gap": true,
      "graph": {
        "phases": [
          {
            "name": "implement",
            "argv": [
              "{binary}",
              "eal",
              "implement",
              "--input",
              "{analysis}",
              "--model",
              "{model}",
              "--api-key-env",
              "{api_key_env}",
              "--tool-language",
              "rust",
              "--toolchain",
              "{toolchain}",
              "--tool-store",
              "{work}/packages",
              "--tool-output-dir",
              "{work}/implementation",
              "--tool-max-calls",
              "4",
              "--http-retries",
              "0",
              "--tools",
              "{tools}",
              "--eal-host",
              "{eal_host}"
            ],
            "timeout_seconds": 3600,
            "report": "{work}/implementation/analysis.with-tools.json",
            "assertions": [
              {
                "file": "{work}/implementation/analysis.with-tools.json",
                "pointer": "/tooling/operations",
                "nonempty": true
              }
            ],
            "audit": "{work}/implementation/tooling.audit.jsonl",
            "counters": {
              "generated_code_count": {
                "file": "{work}/implementation/analysis.with-tools.json",
                "pointer": "/tooling/operations/*/implementation/reused",
                "count_equals": false
              }
            }
          },
          {
            "name": "qualify",
            "argv": [
              "{qualifier}",
              "--input",
              "{work}/implementation/analysis.with-tools.json",
              "--measurement-reference",
              "{qualification}",
              "--output",
              "{work}/qualified.json"
            ],
            "timeout_seconds": 3600,
            "report": "{work}/qualified.json",
            "assertions": [
              {
                "file": "{work}/qualified.json",
                "pointer": "/accepted",
                "equals": true
              }
            ],
            "qualification_reference": "qualification"
          },
          {
            "name": "build",
            "argv": [
              "{binary}",
              "build",
              "--input",
              "{work}/implementation/analysis.with-tools.json",
              "--tools",
              "{work}/implementation/bindings/tools.toml",
              "--output-dir",
              "{work}/package"
            ],
            "timeout_seconds": 3600,
            "report": "{work}/package/build.json",
            "assertions": [
              {
                "file": "{work}/package/build.json",
                "pointer": "/claims/current_claim",
                "nonempty": true
              }
            ],
            "captures": {
              "claim_name": {
                "file": "{work}/package/build.json",
                "pointer": "/claims/current_claim"
              }
            },
            "artefacts": [
              "{work}/package/tools.toml",
              "{work}/package/case.eal"
            ]
          },
          {
            "name": "collect",
            "argv": [
              "{binary}",
              "eal",
              "collect",
              "--input",
              "{work}/package/case.eal",
              "--eal-host",
              "{eal_host}",
              "--workspace",
              "{work}",
              "--database",
              "{work}/assessment.sqlite",
              "--tools",
              "{work}/package/tools.toml",
              "--collector-env",
              "PATH",
              "--collector-env",
              "HOME",
              "--output",
              "{work}/collection.json",
              "--public-collector-env",
              "PATH",
              "--public-collector-env",
              "HOME",
              "--claim",
              "{claim_name}"
            ],
            "timeout_seconds": 3600,
            "report": "{work}/collection.json",
            "assertions": [
              {
                "file": "{work}/collection.json",
                "pointer": "/result/collection_id",
                "nonempty": true
              }
            ],
            "captures": {
              "collection_id": {
                "file": "{work}/collection.json",
                "pointer": "/result/collection_id"
              }
            },
            "counters": {
              "source_requests": {
                "file": "{work}/collection.json",
                "pointer": "/result/records/*/details/metrics/source_requests"
              },
              "request_bytes": {
                "file": "{work}/collection.json",
                "pointer": "/result/records/*/details/metrics/reported_request_bytes"
              },
              "response_bytes": {
                "file": "{work}/collection.json",
                "pointer": "/result/records/*/details/metrics/reported_response_bytes"
              },
              "generated_code_count": {
                "file": "{work}/collection.json",
                "pointer": "/result/records/*/details/metrics/generated_code_count"
              },
              "reused_sources": {
                "file": "{work}/collection.json",
                "pointer": "/result/records/*/details/metrics/reused_sources"
              }
            }
          },
          {
            "name": "assess",
            "argv": [
              "{binary}",
              "eal",
              "assess",
              "--input",
              "{work}/package/case.eal",
              "--collection-id",
              "{collection_id}",
              "--now",
              "{now}",
              "--eal-host",
              "{eal_host}",
              "--workspace",
              "{work}",
              "--database",
              "{work}/assessment.sqlite",
              "--tools",
              "{work}/package/tools.toml",
              "--output",
              "{work}/assessment.json",
              "--collector-env",
              "PATH",
              "--collector-env",
              "HOME",
              "--public-collector-env",
              "PATH",
              "--public-collector-env",
              "HOME"
            ],
            "timeout_seconds": 3600,
            "report": "{work}/assessment.json",
            "assertions": [
              {
                "file": "{work}/assessment.json",
                "pointer": "/result/claims/{claim_name}/status",
                "equals": "supported"
              },
              {
                "file": "{work}/assessment.json",
                "pointer": "/result/collection_id",
                "equals": "{collection_id}"
              }
            ]
          }
        ]
      },
      "direct": {
